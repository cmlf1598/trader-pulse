# Base URL of the TraderPulse API (FastAPI). The browser calls it directly, so it must be
# reachable from the user's machine and allowed by the backend CORS policy (FRONTEND_URL).
# Inlined at build time: changing it requires a rebuild / redeploy.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Optional: quote polling interval in ms (min 5000, default 60000).
NEXT_PUBLIC_POLL_INTERVAL_MS=60000
