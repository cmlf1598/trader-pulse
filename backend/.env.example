# --- Required -------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey  (never commit the real value)
GEMINI_API_KEY=your-gemini-api-key
# Exact origin of the Next.js app (CORS allow-list). Must be https in production.
FRONTEND_URL=http://localhost:3000

# --- Optional -------------------------------------------------------------
# development | production (production hides /docs and allows only FRONTEND_URL)
ENVIRONMENT=development
# Gemini model id. Default is the Gemini 3 Flash preview; e.g. gemini-3.8-flash is stable.
GEMINI_MODEL=gemini-3-flash-preview
# Cloud Run injects PORT automatically.
PORT=8080
# Seconds a successful sentiment analysis is reused (0 disables the cache).
SENTIMENT_CACHE_TTL_SECONDS=600
# Timeout for each Yahoo Finance / Gemini call.
UPSTREAM_TIMEOUT_SECONDS=15
